# Labour Chowk — environment variables
#
# PostgreSQL connection string. Works with Vercel Postgres, Neon, Supabase,
# Railway, or any Postgres instance.
#
# Local example:
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/labourchowk?schema=public"
#
# On Vercel: add DATABASE_URL under Project → Settings → Environment Variables.
# If you use Vercel Postgres / Neon, copy the "Prisma" connection string they provide.
DATABASE_URL=

# Optional: unpooled/direct connection (Neon / Vercel Postgres pooled setups).
# DATABASE_URL_UNPOOLED=
